<p>本服采用邀请制，请向服主领取邀请码。每个邀请码仅可注册一次。</p>
<form id="invite-register">
  <input type="hidden" name="_token" value="{{ csrf_token() }}">
  <div class="form-group"><label for="invite-code">邀请码</label><input id="invite-code" class="form-control" name="invite_code" required maxlength="80" autocomplete="off"></div>
  <div class="form-group"><label for="invite-email">邮箱</label><input id="invite-email" class="form-control" type="email" name="email" required autocomplete="email"></div>
  <div class="form-group"><label for="invite-player">游戏角色名</label><input id="invite-player" class="form-control" name="player_name" required minlength="3" maxlength="16" pattern="[A-Za-z0-9_]+" autocomplete="username"></div>
  <div class="form-group"><label for="invite-pass">密码（8–32 位）</label><input id="invite-pass" class="form-control" type="password" name="password" required minlength="8" maxlength="32" autocomplete="new-password"></div>
  <div class="form-group"><label for="invite-captcha">图片验证码</label><div><img id="invite-captcha-img" src="{{ url('/auth/captcha') }}" alt="验证码" title="点击更换" style="cursor:pointer"></div><input id="invite-captcha" class="form-control" name="captcha" required autocomplete="off"></div>
  <p id="invite-message" role="alert" style="color:#b42318"></p>
  <button class="btn btn-primary btn-block" type="submit">注册</button>
  <p class="mt-3"><a href="{{ url('/auth/login') }}">已有账号？前往登录</a></p>
</form>
<script>
(function(){
const form=document.getElementById('invite-register'), img=document.getElementById('invite-captcha-img'), msg=document.getElementById('invite-message');
img.onclick=()=>{img.src='/auth/captcha?t='+Date.now()};
form.addEventListener('submit',async function(e){e.preventDefault();const button=form.querySelector('button');button.disabled=true;msg.textContent='';
try{const r=await fetch('/auth/register',{method:'POST',body:new FormData(form),headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'},credentials:'same-origin'});const data=await r.json();
if(r.ok&&data.code===0){location.href='/user';return;}
msg.textContent=data.errors?Object.values(data.errors).flat().join(' '):(data.message||data.msg||'注册失败，请检查填写内容。');img.click();form.elements.captcha.value='';
}catch(err){msg.textContent='请求失败，请稍后重试。';}finally{button.disabled=false;}});
})();
</script>
