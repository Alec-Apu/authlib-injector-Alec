<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <link rel="preload" as="image" href="{{ home_pic_url }}">
    <title>{{ site_name }}</title>
    <style>
      .home-page-background { background-image: url('{{ home_pic_url }}'); }
    </style>
    {{ include('assets.home-css', ignore_missing = true) }}
  </head>

  <body class="home-page hold-transition layout-top-nav">
    <div class="home-page-background" aria-hidden="true"></div>
    <div class="hp-wrapper">
      <nav class="home-glass-nav navbar navbar-expand fixed-top navbar-{{ navbar_color }} navbar-{{ color_mode }}
        ml-0 {{ transparent_navbar ? 'transparent' }}"
      >
        <div class="home-nav-inner container">
          <div class="navbar-header">
            <a href="{{ url('/') }}" class="navbar-brand">{{ site_name }}</a>
          </div>

          <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="{{ url('skinlib') }}">{{ trans('general.skinlib') }}</a>
              </li>

              {{ include('shared.languages') }}

              {% if auth_check() %}
                {{ include('shared.user-menu') }}
              {% else %}
                <li class="nav-item">
                  <a class="nav-link" href="{{ url('auth/login') }}">
                    <i class="icon fas fa-sign-in-alt"></i>
                    {{ trans('general.login') }}
                  </a>
                </li>
              {% endif %}
            </ul>
          </div>
        </div>
      </nav>

      <div class="container">
        <div class="splash">
          <h1 class="splash-head">{{ site_name }}</h1>
          <p class="splash-subhead">
            {{ site_description }}
          </p>
          <p>
            {% if auth_check() %}
              <a href="{{ url('user') }}" class="main-button">
                {{ trans('general.user-center') }}
              </a>
            {% else %}
              <a href="{{ url('auth/register') }}" class="main-button">
                {{ trans('general.register') }}
              </a>
            {% endif %}
          </p>
        </div>
      </div>

      {% if hide_intro %}
        <div id="copyright" class="without-intro">
          <div class="home-dock container"><div class="home-dock-content">
            {{ include('shared.copyright') }}
          </div>
          </div>
        </div>
      {% endif %}
    </div>

    {% if not hide_intro %}
      <div id="intro">
        <div class="container">
          <div class="home-section-shell text-center">
            <h1 class="home-section-title">{{ trans('index.features.title') }}</h1>

            <div class="container-lg">
              <div class="home-feature-grid row">
                {% for item in ['first', 'second', 'third'] %}
                  <div class="home-feature-column col-lg"><div class="home-glass-box home-feature-box">
                    <span class="home-feature-icon"><i class="fas {{ trans("index.features.#{item}.icon") }}" aria-hidden="true"></i></span>
                    <h3>{{ trans("index.features.#{item}.name") }}</h3>
                    <p>{{ trans("index.features.#{item}.desc")|raw }}</p>
                  </div></div>
                {% endfor %}
              </div>
            </div>
          </div>
          <br>
        </div>
      </div>
      <div id="footer-wrap">
        <div class="container">
          <div class="home-glass-box home-cta-box row">
            <div class="home-cta-copy col-lg-8 mb-2">
              {{ trans('index.introduction', {sitename: site_name}) }}
            </div>
            <div class="home-cta-action col-lg-4 d-flex justify-content-center align-items-center">
              <a href="{{ url('auth/register') }}" class="main-button">
                {{ trans('index.start') }}
              </a>
            </div>
          </div>
        </div>
      </div>
      <div id="copyright" class="with-intro">
        <div class="home-dock container"><div class="home-dock-content">
          {{ include('shared.copyright') }}
        </div>
        </div>
      </div>
    {% endif %}

    <script type="application/json" id="blessing-extra">
      {{ {transparent_navbar: transparent_navbar}|json_encode|raw }}
    </script>
    {{ include('assets.home', ignore_missing = true) }}
    {{ include('shared.foot') }}
  </body>
</html>
